APP_NAME=Aiss Road API
DATABASE_URL=sqlite:///./rta_dev.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
FRONTEND_URL=http://localhost:3000

# Gmail SMTP. Use the Google App Password you created for AA_API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=your-gmail-address@gmail.com

# Comma-separated verified admin emails
ADMIN_EMAILS=

# Default police-dashboard admin. Created automatically on startup.
DEFAULT_ADMIN_EMAIL=samrawityisak60@gmail.com
DEFAULT_ADMIN_PASSWORD=PoliceAdiss2026!
DEFAULT_ADMIN_NAME=Police Command Admin

# Fictional sample reports for a demo. Keep false so the dashboard shows only real reports from the app.
# Local/demo only - leave false in production.
SEED_DEMO_DATA=false

# Email (verification and password-reset codes). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=your Gmail address, SMTP_PASSWORD=a 16-character Google App Password.
# Test it with:  python -m scripts.test_email you@example.com
# Local development only: print codes in the console when the email cannot be sent.
OTP_CONSOLE_FALLBACK=false

# ---------------------------------------------------------------------------------------------
# PRODUCTION on free hosting (Render + Neon + Brevo). Set these as Environment Variables on the
# host. Do NOT commit a real .env file. See DEPLOY.md.
#
# APP_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require     (from Neon)
# JWT_SECRET_KEY=<random, 32+ characters>
# DEFAULT_ADMIN_EMAIL=<your admin email>
# DEFAULT_ADMIN_PASSWORD=<a strong private password>
# STORAGE_BACKEND=db            (photos are stored in the database; free hosts erase the disk)
# BREVO_API_KEY=<from Brevo>    (email over HTTPS; Render's free tier blocks SMTP ports)
# EMAIL_FROM=<the sender address you verified in Brevo>
# OTP_CONSOLE_FALLBACK=false
# SEED_DEMO_DATA=false

